#!/usr/bin/env python3

import re
import csv
from pathlib import Path

# =========================
# USER INPUT
# =========================
BASE_DIR = Path("/home/tofick/Bacillus_Project/busco_results")
OUTPUT_FILE = Path("busco_results_summary.csv")


# =========================
# PARSE BUSCO FILE
# =========================
def parse_busco_file(file_path):

    try:
        content = file_path.read_text()
    except Exception as e:
        print(f"ERROR reading {file_path}: {e}")
        return None

    # Correct BUSCO v6 pattern
    pattern = r"C:([\d\.]+)%\[S:([\d\.]+)%,D:([\d\.]+)%\],F:([\d\.]+)%,M:([\d\.]+)%,n:(\d+)"

    match = re.search(pattern, content)

    if not match:
        print(f"WARNING: BUSCO pattern not found in {file_path}")
        return None

    return {
        "Complete": float(match.group(1)),
        "Single_copy": float(match.group(2)),
        "Duplicated": float(match.group(3)),
        "Fragmented": float(match.group(4)),
        "Missing": float(match.group(5)),
        "Total": int(match.group(6))
    }


# =========================
# MAIN PIPELINE
# =========================
def main():

    print("\n==============================")
    print("BUSCO PARSER STARTING")
    print("==============================\n")

    if not BASE_DIR.exists():
        print(f"ERROR: BASE_DIR not found: {BASE_DIR}")
        return

    rows = []

    folders = [f for f in BASE_DIR.iterdir() if f.is_dir()]

    print(f"Found {len(folders)} BUSCO folders\n")

    for i, folder in enumerate(folders, 1):

        busco_files = list(folder.glob("short_summary*.txt"))

        if not busco_files:
            print(f"[{i}] No BUSCO file in {folder.name}")
            continue

        file_path = busco_files[0]

        data = parse_busco_file(file_path)

        if not data:
            print(f"[{i}] Failed parsing {folder.name}")
            continue

        genome = folder.name

        rows.append({
            "Genome": genome,
            **data
        })

        print(f"[{i}] OK → {genome}")

    # =========================
    # WRITE CSV
    # =========================
    with open(OUTPUT_FILE, "w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=rows[0].keys())
        writer.writeheader()
        writer.writerows(rows)

    print("\n==============================")
    print("DONE ✔")
    print(f"Output saved to: {OUTPUT_FILE}")
    print(f"Genomes processed: {len(rows)}")
    print("==============================\n")


if __name__ == "__main__":
    main()
