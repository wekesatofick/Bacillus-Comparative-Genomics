import os
import pandas as pd

input_dir = "/home/tofick/Bacillus_Project/prokka_faa/RGI_results"

files = [f for f in os.listdir(input_dir) if f.endswith(".txt")]

all_data = []

for f in files:
    genome = f.replace(".txt", "")
    path = os.path.join(input_dir, f)

    df = pd.read_csv(path, sep="\t")

    # Keep only important columns
    cols = ["Best_Hit_ARO", "Drug Class", "Resistance Mechanism"]
    df = df[cols].dropna()

    df["Genome"] = genome

    all_data.append(df)

data = pd.concat(all_data)

# -------------------------
# 1. Genome × ARO matrix
# -------------------------
aro_matrix = pd.crosstab(data["Genome"], data["Best_Hit_ARO"])
aro_matrix = (aro_matrix > 0).astype(int)
aro_matrix.to_csv("Genome_ARO_matrix.csv")

# -------------------------
# 2. Genome × Drug Class
# -------------------------
drug_matrix = pd.crosstab(data["Genome"], data["Drug Class"])
drug_matrix.to_csv("Genome_DrugClass_matrix.csv")

# -------------------------
# 3. Genome × Resistance Mechanism
# -------------------------
mech_matrix = pd.crosstab(data["Genome"], data["Resistance Mechanism"])
mech_matrix.to_csv("Genome_Mechanism_matrix.csv")

# -------------------------
# 4. Core vs accessory resistome
# -------------------------
aro_freq = aro_matrix.sum(axis=0) / aro_matrix.shape[0]

core = aro_freq[aro_freq >= 0.95].index
accessory = aro_freq[aro_freq < 0.95].index

core_df = pd.DataFrame(core, columns=["Core_AROs"])
accessory_df = pd.DataFrame(accessory, columns=["Accessory_AROs"])

core_df.to_csv("Core_AROs.csv", index=False)
accessory_df.to_csv("Accessory_AROs.csv", index=False)

print("DONE: All matrices generated")
