#!/bin/bash

INPUT_DIR="/home/tofick/Bacillus_Project/prokka_gbk_files"
OUTPUT_DIR="/home/tofick/Bacillus_Project/antismash_results"
LOG_DIR="${OUTPUT_DIR}/logs"

THREADS=6
CPUS_PER_GENOME=2

mkdir -p "${OUTPUT_DIR}" "${LOG_DIR}"

process_genome() {
    gbk_file="$1"
    base_id=$(basename "$gbk_file" .gbk)
    log_file="${LOG_DIR}/${base_id}.log"
    outdir="${OUTPUT_DIR}/${base_id}"

    echo "START $base_id" | tee "$log_file"

    antismash \
        --output-dir "$outdir" \
        --genefinding-tool prodigal \
        --taxon bacteria \
        --cpus $CPUS_PER_GENOME \
        "$gbk_file" &>> "$log_file"

    if [ $? -eq 0 ]; then
        echo "SUCCESS" | tee -a "$log_file"
    else
        echo "FAILED" | tee -a "$log_file"
    fi
}

export -f process_genome
export OUTPUT_DIR LOG_DIR CPUS_PER_GENOME

find "$INPUT_DIR" -maxdepth 1 -name "*.gbk" | \
xargs -P $THREADS -I {} bash -c 'process_genome "$1"' _ {}
chmod +x run_antismash.sh
./run_antismash.sh
