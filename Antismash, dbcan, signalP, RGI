#!/bin/bash

###############################################################################
# POST-antiSMASH ANALYSIS PIPELINE (FIXED VERSION)
###############################################################################

ANTISMASH_DIR="/home/tofick/Bacillus_Project/antismash_results"
OUT="/home/tofick/Bacillus_Project/post_antismash"

SUMMARY="${OUT}/BGC_summary.tsv"
MATRIX="${OUT}/BGC_matrix.tsv"

mkdir -p "${OUT}"

echo -e "Genome\tRegion\tProduct" > "${SUMMARY}"

###############################################################################
# STEP 1 — EXTRACT BGC DATA (FIXED GENE NAME HANDLING)
###############################################################################

echo "Extracting BGC data..."

find "${ANTISMASH_DIR}" -name "*region*.gbk" | while read file
do
    # FIX: use full sample folder name (NOT internal accession)
    genome=$(basename "$(dirname "$file")")

    region=$(basename "$file" | grep -o "region[0-9]*")

    product=$(grep "/product=" "$file" | head -1 | \
        sed 's/.*product="//' | sed 's/"//')

    echo -e "${genome}\t${region}\t${product}" >> "${SUMMARY}"

done

echo "BGC summary created: ${SUMMARY}"

###############################################################################
# STEP 2 — COUNT BGC TYPES
###############################################################################

echo "Counting BGC types..."

cut -f3 "${SUMMARY}" | sort | uniq -c | sort -nr \
> "${OUT}/BGC_type_counts.txt"

###############################################################################
# STEP 3 — CREATE PRESENCE/ABSENCE MATRIX (FIXED ORDER ISSUE)
###############################################################################

echo "Building matrix..."

awk -F'\t' '
NR>1{
    genomes[$1]=1
    bgcs[$3]=1
    matrix[$1,$3]=1
}

END{
    printf "Genome"

    for (b in bgcs)
        printf "\t%s", b

    printf "\n"

    for (g in genomes){
        printf "%s", g

        for (b in bgcs){
            if(matrix[g,b]==1)
                printf "\t1"
            else
                printf "\t0"
        }
        printf "\n"
    }
}
' "${SUMMARY}" > "${MATRIX}"

###############################################################################
# STEP 4 — CORE & UNIQUE BGCs
###############################################################################

TOTAL_GENOMES=$(cut -f1 "${SUMMARY}" | tail -n +2 | sort | uniq | wc -l)

# Core BGCs (present in ALL genomes)
awk -F'\t' -v total="${TOTAL_GENOMES}" '
NR>1{
    count[$3]++
}

END{
    for (b in count){
        if(count[b]==total)
            print b
    }
}
' "${SUMMARY}" > "${OUT}/core_BGCs.txt"

# Unique BGCs
cut -f3 "${SUMMARY}" | sort | uniq -u > "${OUT}/unique_BGCs.txt"

###############################################################################
# STEP 5 — SUMMARY
###############################################################################

echo "DONE"
echo "Output folder: ${OUT}"

echo ""
echo "Files generated:"
echo " - BGC_summary.tsv"
echo " - BGC_matrix.tsv"
echo " - BGC_type_counts.txt"
echo " - core_BGCs.txt"
echo " - unique_BGCs.txt"

