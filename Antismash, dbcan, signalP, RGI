#!/usr/bin/env python3

import pandas as pd
import glob
import os
import re

dbcan_dir = "/home/tofick/Bacillus_Project/dbcan_results"

all_families = set()
genome_profiles = {}

overview_files = glob.glob(
    os.path.join(dbcan_dir, "*", "overview.tsv")
)

print(f"Found {len(overview_files)} overview files")

for file in overview_files:

    genome = os.path.basename(os.path.dirname(file))

    try:
        df = pd.read_csv(file, sep="\t")

    except Exception as e:
        print(f"Skipping {genome}: {e}")
        continue

    families = set()

    if "Recommend Results" not in df.columns:
        print(f"No Recommend Results column in {genome}")
        continue

    for val in df["Recommend Results"].dropna():

        val = str(val)

        if val == "-" or val.strip() == "":
            continue

        hits = val.split("|")

        for hit in hits:

            fam = re.sub(r"_e\d+$", "", hit)

            fam = re.sub(r"_e\d+.*", "", fam)

            fam = fam.strip()

            if fam != "":
                families.add(fam)

    genome_profiles[genome] = families
    all_families.update(families)

print(f"Detected {len(all_families)} CAZyme families")

all_families = sorted(all_families)

matrix = pd.DataFrame(
    0,
    index=sorted(genome_profiles.keys()),
    columns=all_families
)

for genome, fams in genome_profiles.items():
    for fam in fams:
        matrix.loc[genome, fam] = 1

matrix.to_csv("CAZyme_presence_absence.csv")

print(matrix.shape)
print("Saved CAZyme_presence_absence.csv")
