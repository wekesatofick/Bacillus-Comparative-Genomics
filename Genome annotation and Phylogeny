/home/tofick/Bacillus_Project/checkm_input
nano run_prokka.sh
#!/bin/bash

set -euo pipefail

# ======================
# PARAMETERS
# ======================
GENOME_DIR="/home/tofick/Bacillus_Project/checkm_input"
OUTDIR="/home/tofick/Bacillus_Project/prokka_out"

GENUS="Bacillus"
KINGDOM="Bacteria"

# Adjust depending on your CPU/RAM
CPUS=20

# ======================
# CREATE OUTPUT DIRECTORY
# ======================
mkdir -p "$OUTDIR"

# Avoid errors if no .fna files exist
shopt -s nullglob

# ======================
# RUN PROKKA
# ======================
for genome in "$GENOME_DIR"/*.fna; do

    base=$(basename "$genome" .fna)

    echo "======================================="
    echo "Annotating: $base"
    echo "======================================="

    prokka "$genome" \
        --outdir "$OUTDIR/$base" \
        --prefix "$base" \
        --genus "$GENUS" \
        --kingdom "$KINGDOM" \
        --cpus "$CPUS"

done

echo "======================================="
echo "Annotation complete!"
echo "Results saved in: $OUTDIR"
echo "======================================="

chmod +x run_prokka.sh
./run_prokka.sh

